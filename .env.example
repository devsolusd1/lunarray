# Copie para .env e preencha. NUNCA commite o .env nem cole valores reais neste arquivo.

# carteira de deploy: chave privada (0x + 64 hex) de uma conta limpa, só pra os tx de deploy e pro keeper
DEPLOYER_PK=

# RPC (Alchemy, oficial ou publicnode)
RH_RPC=https://robinhood-rpc.publicnode.com
RH_TESTNET_RPC=https://robinhood-sepolia-rpc.publicnode.com

# --- passo 1: FeeSplitter ---
# tesouraria: endereco que recebe 60% de cada harvest (= 3% dos 5% de creator tax). IMUTAVEL depois do deploy. Pode ser carteira fria.
TREASURY=
TREASURY_BPS=6000

# --- passo 2: launch na Pons (scripts/0-launch-pons.js) com creatorFeeRecipient = FeeSplitter ---
# tudo abaixo vai ON-CHAIN e e imutavel (o site da Pons le do contrato do token); DRY_RUN=1 so simula
CREATOR_TAX_BPS=500
LAUNCH_NAME=Lunarray
LAUNCH_SYMBOL=LUNARRAY
# logo: o site da Pons grava ipfs://CID (suba a imagem no Pinata). Nada depois do valor, nem comentario
LAUNCH_LOGO=
LAUNCH_DESCRIPTION=
LAUNCH_WEBSITE=https://SEU-DOMINIO
LAUNCH_TWITTER=
LAUNCH_TELEGRAM=
LAUNCH_DISCORD=
LAUNCH_FARCASTER=
# compra inicial na mesma tx (isenta de snipe tax), em ETH; vazio = sem compra
DEV_BUY_ETH=
# carteiras extras isentas da snipe tax de abertura, separadas por virgula (max 32)
SNIPE_EXEMPT=
LAUNCH_CONFIG_ID=0
# so pra reproduzir um endereco previsto na simulacao; vazio = aleatorio
LAUNCH_SALT=
# so no DRY_RUN: simular como outra carteira
LAUNCH_FROM=

# --- passo 3: BondEngine (logo depois do launch; funciona desde a curva) ---
# guardian: pausa entradas (max 7 dias), propoe parametros com 48h, e faz sweepIdle() depois de 30 dias sem bonds. Pode ser a mesma carteira da tesouraria.
GUARDIAN=
# token criado na Pons e splitter do passo 1
TOKEN=
SPLITTER=

# --- passo 4: keeper ---
ENGINE=

# --- passo 5: lock dos tokens da dev wallet (scripts/5-lock-dev-tokens.js) ---
# data de desbloqueio: 2027-03-15 ou duracao (+180d, +12m, +1y). So pode ser ESTENDIDA depois.
LOCK_UNTIL=
# quem saca depois da data (vazio = TREASURY). quantidade em tokens inteiros (vazio = saldo todo da dev wallet)
LOCK_BENEFICIARY=
LOCK_AMOUNT=
# endereco do DevLock depois do deploy (pra depositar mais depois)
DEVLOCK=
